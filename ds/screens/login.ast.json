{
  "screen": "Login",
  "title": "Вход в личный кабинет",
  "order": 1,
  "frame": {
    "width": 400,
    "padding": 24,
    "gap": 20,
    "background": "color/background"
  },
  "elements": [
    {
      "component": "Badge",
      "props": {
        "variant": "outline"
      },
      "slots": {
        "label": "Личный кабинет"
      }
    },
    {
      "component": "Heading",
      "props": {
        "level": "h1"
      },
      "slots": {
        "text": "Вход"
      }
    },
    {
      "component": "Text",
      "props": {
        "variant": "muted"
      },
      "slots": {
        "text": "Используйте рабочую почту и пароль, выданный администратором."
      }
    },
    {
      "component": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    {
      "type": "stack",
      "direction": "VERTICAL",
      "gap": 16,
      "children": [
        {
          "type": "stack",
          "direction": "VERTICAL",
          "gap": 6,
          "children": [
            {
              "component": "Label",
              "slots": {
                "label": "Email"
              }
            },
            {
              "component": "Input",
              "props": {
                "state": "default"
              },
              "slots": {
                "placeholder": "name@company.ru"
              }
            }
          ]
        },
        {
          "type": "stack",
          "direction": "VERTICAL",
          "gap": 6,
          "children": [
            {
              "component": "Label",
              "slots": {
                "label": "Пароль"
              }
            },
            {
              "component": "Input",
              "props": {
                "state": "error"
              },
              "slots": {
                "placeholder": "Неверный пароль"
              }
            }
          ]
        },
        {
          "type": "stack",
          "direction": "HORIZONTAL",
          "gap": 8,
          "children": [
            {
              "component": "Checkbox",
              "props": {
                "checked": "false"
              }
            },
            {
              "component": "Text",
              "props": {
                "variant": "default"
              },
              "slots": {
                "text": "Запомнить устройство"
              }
            }
          ]
        }
      ]
    },
    {
      "component": "Button",
      "props": {
        "variant": "default",
        "size": "default"
      },
      "slots": {
        "label": "Войти"
      },
      "stretch": true
    },
    {
      "component": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    {
      "type": "stack",
      "direction": "HORIZONTAL",
      "gap": 12,
      "children": [
        {
          "component": "Button",
          "props": {
            "variant": "link",
            "size": "default"
          },
          "slots": {
            "label": "Забыли пароль?"
          }
        },
        {
          "component": "Button",
          "props": {
            "variant": "ghost",
            "size": "default"
          },
          "slots": {
            "label": "Получить доступ"
          }
        }
      ]
    }
  ]
}
