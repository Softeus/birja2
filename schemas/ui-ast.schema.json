{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ui-ast.schema.json",
  "title": "UI AST для сборки экранов из компонентов ДС",
  "type": "object",
  "required": [
    "screen",
    "frame",
    "elements"
  ],
  "additionalProperties": false,
  "properties": {
    "screen": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "title": {
      "type": "string"
    },
    "frame": {
      "type": "object",
      "required": [
        "width"
      ],
      "additionalProperties": false,
      "properties": {
        "width": {
          "type": "number",
          "minimum": 200,
          "maximum": 1200
        },
        "padding": {
          "type": "number",
          "default": 24
        },
        "gap": {
          "type": "number",
          "default": 16
        },
        "background": {
          "type": "string",
          "default": "color/background"
        }
      }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/element"
      }
    },
    "order": {
      "type": "number",
      "description": "Порядок экрана в потоке (слева направо)"
    }
  },
  "definitions": {
    "element": {
      "oneOf": [
        {
          "$ref": "#/definitions/stack"
        },
        {
          "$ref": "#/definitions/component"
        },
        {
          "$ref": "#/definitions/heatmap"
        }
      ]
    },
    "stack": {
      "type": "object",
      "required": [
        "type",
        "children"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "stack"
          ]
        },
        "direction": {
          "enum": [
            "VERTICAL",
            "HORIZONTAL"
          ],
          "default": "VERTICAL"
        },
        "gap": {
          "type": "number",
          "default": 12
        },
        "padding": {
          "type": "number",
          "default": 0
        },
        "stretch": {
          "type": "boolean",
          "default": true
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/element"
          }
        },
        "grow": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "component"
      ],
      "additionalProperties": false,
      "properties": {
        "component": {
          "type": "string"
        },
        "props": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "stretch": {
          "type": "boolean",
          "default": true
        },
        "grow": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "heatmap": {
      "type": "object",
      "required": [
        "type",
        "width",
        "height",
        "sectors"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "heatmap"
          ]
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "sectors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/heatmapSector"
          }
        }
      }
    },
    "heatmapSector": {
      "type": "object",
      "required": [
        "sector",
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "sector": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "tiles": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/heatmapTile"
          }
        }
      }
    },
    "heatmapTile": {
      "type": "object",
      "required": [
        "secId",
        "x",
        "y",
        "width",
        "height",
        "level"
      ],
      "additionalProperties": false,
      "properties": {
        "secId": {
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "level": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "price": {
          "type": "string"
        }
      }
    }
  }
}
